    global waiting_for_code, received_code, active_driver
    
    try:
        code_input = WebDriverWait(driver, 15).until(
            EC.presence_of_element_located((By.CSS_SELECTOR, "input[type='text'], input[inputmode='numeric'], input[name='code']"))
        )
        
        while True:
