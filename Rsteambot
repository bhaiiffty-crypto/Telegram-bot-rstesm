import logging
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, filters, ContextTypes

# Enable logging to catch errors and trace execution
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)

# 1. Define command handlers
async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Sends a greeting message when the user types /start."""
    user_name = update.effective_user.first_name
    await update.message.reply_text(f"Hello {user_name}! I am an echo bot. Send me any message!")

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Provides usage instructions when the user types /help."""
    await update.message.reply_text("Just send me text and I'll send it back to you!")

# 2. Define a text message handler
async def echo_message(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Echoes back any text message the user sends."""
    user_text = update.message.text
    await update.message.reply_text(f"You said: {user_text}")

# 3. Main function to initialize and run the bot
def main():
    # Replace with your actual token from BotFather
    BOT_TOKEN = "8824437416:AAGj15dLQZa7pqbRD-z8u7GQXaYG7hR9iXc"
    
    # Initialize the application
    app = ApplicationBuilder().token(BOT_TOKEN).build()
    
    # Register the command and message handlers
    app.add_handler(CommandHandler("start", start_command))
    app.add_handler(CommandHandler("help", help_command))
    
    # Filter only text messages (ignore images, audio, or command triggers)
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, echo_message))
    
    # Start checking for updates (Polling method)
    print("Bot is starting up... Press Ctrl+C to stop.")
    app.run_polling()

if __name__ == '__main__':
    main()
